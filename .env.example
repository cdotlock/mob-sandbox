# ============================================================
# mob-sandbox-platform — environment template
# Copy to .env and fill in all values before running deploy.sh
# .env is gitignored — never commit secrets to this repo
# ============================================================

# --- Infrastructure ---
VM_IP=             # Vultr VPS public IPv4, e.g. 203.0.113.42
VM_ID=             # Vultr instance UUID (from vultr-cli or dashboard)
DOMAIN=            # Apex domain managed by Porkbun, e.g. example.com
ACME_EMAIL=        # Let's Encrypt contact email, e.g. you@example.com

# --- Porkbun DNS (used by Traefik ACME DNS-01 + setup-dns.sh) ---
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# --- LLM for OpenHands ---
LLM_API_KEY=       # DeepSeek API key  (sk-...)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# --- Daytona admin API key (generated by deploy.sh, stored here) ---
# Leave blank — deploy.sh generates and writes this automatically
DAYTONA_API_KEY=

# --- Vultr API ---
# Used by:
#   - vultr-cli for VM provisioning
#   - Cloudflare Worker for power control (mob power start/stop/status)
# For multi-operator setups, prefer the Cloudflare Worker so this key
# never leaves your machine. See infra/power-worker/README.md.
VULTR_API_KEY=
VULTR_SSH_KEY_ID=  # UUID returned by 'POST /v2/ssh-keys' (used in 'POST /v2/instances')
