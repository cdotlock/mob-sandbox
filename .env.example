# ============================================================
# mob-sandbox-platform — environment template
# Copy to .env and fill in all values before running deploy.sh
# ============================================================

# --- Infrastructure ---
VM_IP=             # Vultr VPS public IPv4, e.g. 45.32.25.73
VM_ID=             # Vultr instance UUID (from vultr-cli or dashboard)
DOMAIN=            # Apex domain managed by Porkbun, e.g. mobai.beauty
ACME_EMAIL=        # Let's Encrypt contact email, e.g. poc@mobai.beauty

# --- Porkbun DNS (used by Traefik ACME DNS-01 + setup-dns.sh) ---
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# --- LLM for OpenHands ---
LLM_API_KEY=       # DeepSeek API key  (sk-...)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# --- Daytona admin API key (generated by deploy.sh, stored here) ---
# Leave blank — deploy.sh generates and writes this automatically
DAYTONA_API_KEY=

# --- Vultr API (only needed if using vultr-cli for VM provisioning) ---
VULTR_API_KEY=
